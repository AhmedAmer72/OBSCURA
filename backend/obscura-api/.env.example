# obscura-api environment variables
# Copy to .env and fill in SECRETS before running locally

# ── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,https://obscuraos.online,https://www.obscuraos.online

# ── ERC-4337 ─────────────────────────────────────────────────────────────────
PAYMASTER_ADDRESS=0x7a8D880D9c5F88Ba8bd4435c450256628F66dd0C
BUNDLER_URL=https://arb-sepolia.g.alchemy.com/v2/<ALCHEMY_KEY>/rpc
BUNDLER_URL_FALLBACK=https://api.pimlico.io/v2/421614/rpc?apikey=<PIMLICO_KEY>

# ── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://quoovjkjwgtdqwdofubh.supabase.co
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE  # Supabase → Project Settings → API → service_role

# ── VAPID (Web Push) ─────────────────────────────────────────────────────────
VAPID_CONTACT_EMAIL=noreply@obscura.finance
VAPID_PUBLIC_KEY=BIgVcwUhCL93WVMnDdRT9KqySwDS4Sm9C-fSLg4dWJRdddSuLbyDv_M9R5FmDi2F8NwDuKuMtvNiZAwZQ0RH86o
VAPID_PRIVATE_KEY=PASTE_VAPID_PRIVATE_KEY_HERE         # Must match the public key — KEEP SECRET

# ── Resend (email) ───────────────────────────────────────────────────────────
RESEND_API_KEY=PASTE_RESEND_API_KEY_HERE               # https://resend.com/api-keys

# ── App wallet session (activity / reputation / prefs GET) ───────────────────
# Obscura frontend: EIP-191 "Obscura App Session" — default 7 days
APP_WALLET_SESSION_MAX_AGE_SEC=604800

# ── Agent tokens (MCP / SDK) ─────────────────────────────────────────────────
# false = wallet-scoped reads require Bearer agent token OR app wallet session
AGENT_AUTH_LEGACY_PUBLIC=false
# AGENT_TOKEN_TTL_DAYS=90
# AGENT_TOKEN_MAX_PER_WALLET=5
# AGENT_AUTH_MAX_AGE_SEC=300

# ── Notification writes (POST /subscribe, DELETE /subscribe, POST /prefs) ───
# Separate from app session — when true, writes require legacy wallet signature
WALLET_AUTH_REQUIRED=false
WALLET_AUTH_MAX_AGE_SEC=300
